{
  "dataset": "cafe",
  "split": "place",
  "val_mode": true,
  "data_path": "Dataset",
  "tracks_path": "",
  "groundtruth": "evaluation/gt_tracks.txt",
  "labelmap": "label_map/group_action_list.pbtxt",
  "image_width": 1280,
  "image_height": 720,
  "num_frame": 5,
  "num_class": 6,
  "num_boxes": 14,
  "random_sampling": false,
  "backbone": "resnet18",
  "dilation": false,
  "frozen_batch_norm": false,
  "hidden_dim": 256,
  "crop_size": 5,
  "gar_nheads": 4,
  "gar_enc_layers": 6,
  "gar_ffn_dim": 512,
  "position_embedding": "sine",
  "num_group_tokens": 12,
  "drop_rate": 0.1,
  "distance_threshold": 0.2,
  "group_threshold": 0.5,
  "temperature": 0.2,
  "aux_loss": false,
  "ce_loss_coef": 1,
  "eos_coef": 1,
  "group_eos_coef": 1,
  "group_ce_loss_coef": 1,
  "group_code_loss_coef": 5,
  "consistency_loss_coef": 2,
  "set_cost_group_class": 1,
  "set_cost_membership": 1,
  "research_b0_repro": true,
  "heatmap_variant": "off",
  "attention_probe": false,
  "heatmap_dim": 64,
  "heatmap_bias": -2,
  "heatmap_alpha": 20,
  "heatmap_sigma_ratio": 0.15,
  "heatmap_sigma_min": 0.5,
  "heatmap_sigma_max": 4,
  "heatmap_roi_size": 3,
  "heatmap_roi_sampling": 2,
  "heatmap_focal_gamma": 2,
  "heatmap_focal_alpha": 0.25,
  "heatmap_focal_coef": 1,
  "heatmap_dice_coef": 1,
  "heatmap_empty_coef": 0.1,
  "heatmap_cost_focal": 1,
  "heatmap_cost_dice": 1,
  "use_mae": false,
  "no_mae": true,
  "random_seed": 1,
  "epochs": 30,
  "batch": 16,
  "micro_batch": 0,
  "test_batch": 1,
  "optimizer": "adam",
  "lr": 0.00001,
  "max_lr": 0.0001,
  "weight_decay": 0,
  "warmup_epochs": 5,
  "lr_schedule": "linear",
  "backbone_lr_scale": 1,
  "gradient_clipping": false,
  "max_norm": 1,
  "selection_metric": "group_mAP_1.0",
  "eval_type": "gt_base",
  "eval_image_width": 1280,
  "eval_image_height": 720,
  "precision": "fp32",
  "criterion_on_cpu": true
}
